diff --git a/Windy.SDK/Command/CommandDispatchResult.cs b/Windy.SDK/Command/CommandDispatchResult.cs
new file mode 100644
index 0000000..29c62d0
--- /dev/null
+++ b/Windy.SDK/Command/CommandDispatchResult.cs
@@ -0,0 +1,65 @@
+namespace Windy.SDK.Command
+{
+    /// <summary>指令分派的状态。</summary>
+    public enum DispatchStatus
+    {
+        /// <summary>指令表里没有匹配项 —— 用户可能打错了名字，或该指令不支持当前场景。</summary>
+        NotFound,
+
+        /// <summary>已成功处理：指令正常执行完毕，或被前置钩子接管。</summary>
+        Handled,
+
+        /// <summary>
+        /// 指令**匹配到了**，但执行过程中抛了异常。
+        ///
+        /// <para>这一态必须和 <see cref="NotFound"/> 区分开：两者的用户提示完全不同。
+        /// 「没有这条指令」是用户的问题（打错字），「执行失败」是系统的问题（要查日志）。
+        /// 混为一谈会让人在系统出错时收到「不知道你想做什么」，既误导又没法排查。</para>
+        /// </summary>
+        Failed,
+    }
+
+    /// <summary>
+    /// 一次指令分派的结果。除了状态，还带上出问题的指令名与错误信息，
+    /// 好让上层直接给用户一句有用的回复，而不必去翻日志。
+    /// </summary>
+    public sealed class CommandDispatchResult
+    {
+        private CommandDispatchResult(DispatchStatus status, string? commandName, string? errorMessage)
+        {
+            Status = status;
+            CommandName = commandName;
+            ErrorMessage = errorMessage;
+        }
+
+        public DispatchStatus Status { get; }
+
+        /// <summary>命中的指令名。<see cref="NotFound"/> 时为 null。</summary>
+        public string? CommandName { get; }
+
+        /// <summary>失败原因。<see cref="DispatchStatus.Failed"/> 时才有值。</summary>
+        public string? ErrorMessage { get; }
+
+        public bool IsHandled => Status == DispatchStatus.Handled;
+
+        public bool IsNotFound => Status == DispatchStatus.NotFound;
+
+        public bool IsFailed => Status == DispatchStatus.Failed;
+
+        /// <summary>未匹配到任何指令。</summary>
+        public static readonly CommandDispatchResult NotFound = new(DispatchStatus.NotFound, null, null);
+
+        /// <summary>成功处理。</summary>
+        public static CommandDispatchResult Handled(string? commandName = null) =>
+            new(DispatchStatus.Handled, commandName, null);
+
+        /// <summary>匹配到了但执行失败。</summary>
+        public static CommandDispatchResult Failed(string commandName, string errorMessage) =>
+            new(DispatchStatus.Failed, commandName, errorMessage);
+
+        public override string ToString() =>
+            Status == DispatchStatus.Failed
+                ? $"Failed({CommandName}): {ErrorMessage}"
+                : Status.ToString();
+    }
+}
